{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    "paths": {
      "video-fps-probe": ["./src/index.ts"],
      "video-fps-probe/client": ["./src/client/index.ts"],
      "video-fps-probe/client/lazy": ["./src/client/lazy.ts"],
      "video-fps-probe/engines/mediabunny": ["./src/engines/mediabunny.ts"],
      "video-fps-probe/engines/mp4box": ["./src/engines/mp4box.ts"],
      "video-fps-probe/lazy": ["./src/lazy.ts"],
      "video-fps-probe/mediabunny": ["./src/plugins/mediabunny.ts"],
      "video-fps-probe/mp4box": ["./src/plugins/mp4box.ts"],
      "video-fps-probe/rvfc": ["./src/plugins/rvfc.ts"],
      "video-fps-probe/worker-runtime": ["./src/worker/runtime.ts"]
    },

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests", "scripts", "vitest.config.ts", "vitest.package.config.ts"]
}
