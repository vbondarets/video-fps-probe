{
  "name": "video-fps-probe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:generate": "bash scripts/fixtures/generate-fixtures.sh",
    "fixtures:refs": "bash scripts/fixtures/extract-reference.sh",
    "compare": "node scripts/compare-ffprobe.ts",
    "size": "node scripts/size-report.mjs",
    "bench": "node scripts/bench/run-bench.mjs"
  },
  "dependencies": {
    "mediabunny": "1.62.0",
    "mp4box": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
