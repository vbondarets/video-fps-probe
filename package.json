{
  "name": "video-fps-probe",
  "private": false,
  "version": "0.4.0-beta.1",
  "description": "Video frame rate, frame count and VFR detection from MP4/MOV/WebM/MKV container headers in a Web Worker. Matches ffprobe 8.1.1 on the test corpus (0 mismatches), no decoding.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbondarets/video-fps-probe.git"
  },
  "homepage": "https://vbondarets.github.io/video-fps-probe/",
  "bugs": "https://github.com/vbondarets/video-fps-probe/issues",
  "keywords": [
    "video",
    "fps",
    "frame-rate",
    "vfr",
    "mp4",
    "mov",
    "webm",
    "mkv",
    "ffprobe",
    "web-worker"
  ],
  "sideEffects": [
    "./dist/worker/*.worker.js",
    "./dist/standalone/*.js",
    "./src/worker/*.worker.ts"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "typesVersions": {
    "*": {
      "lazy": [
        "dist/lazy.d.ts"
      ],
      "client": [
        "dist/client/index.d.ts"
      ],
      "client/lazy": [
        "dist/client/lazy.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "check": [
        "dist/check/index.d.ts"
      ],
      "header": [
        "dist/header/index.d.ts"
      ],
      "url": [
        "dist/url/index.d.ts"
      ],
      "color": [
        "dist/color/index.d.ts"
      ],
      "aspect": [
        "dist/aspect/index.d.ts"
      ],
      "presets": [
        "dist/presets/index.d.ts"
      ],
      "presets/sources.json": [
        "dist/presets/sources.json"
      ],
      "mp4box": [
        "dist/plugins/mp4box.d.ts"
      ],
      "mediabunny": [
        "dist/plugins/mediabunny.d.ts"
      ],
      "rvfc": [
        "dist/plugins/rvfc.d.ts"
      ],
      "worker-runtime": [
        "dist/worker/runtime.d.ts"
      ],
      "engines/mp4box": [
        "dist/engines/mp4box.d.ts"
      ],
      "engines/mediabunny": [
        "dist/engines/mediabunny.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "module-sync": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "module": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "default": "./dist/lazy.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/lazy": {
      "types": "./dist/client/lazy.d.ts",
      "default": "./dist/client/lazy.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./check": {
      "module-sync": {
        "types": "./dist/check/index.d.ts",
        "default": "./dist/check/index.js"
      },
      "module": {
        "types": "./dist/check/index.d.ts",
        "default": "./dist/check/index.js"
      },
      "require": {
        "types": "./dist/cjs/check/index.d.cts",
        "default": "./dist/cjs/check.cjs"
      },
      "types": "./dist/check/index.d.ts",
      "default": "./dist/check/index.js"
    },
    "./header": {
      "module-sync": {
        "types": "./dist/header/index.d.ts",
        "default": "./dist/header/index.js"
      },
      "module": {
        "types": "./dist/header/index.d.ts",
        "default": "./dist/header/index.js"
      },
      "require": {
        "types": "./dist/cjs/header/index.d.cts",
        "default": "./dist/cjs/header.cjs"
      },
      "types": "./dist/header/index.d.ts",
      "default": "./dist/header/index.js"
    },
    "./url": {
      "module-sync": {
        "types": "./dist/url/index.d.ts",
        "default": "./dist/url/index.js"
      },
      "module": {
        "types": "./dist/url/index.d.ts",
        "default": "./dist/url/index.js"
      },
      "require": {
        "types": "./dist/cjs/url/index.d.cts",
        "default": "./dist/cjs/url.cjs"
      },
      "types": "./dist/url/index.d.ts",
      "default": "./dist/url/index.js"
    },
    "./color": {
      "module-sync": {
        "types": "./dist/color/index.d.ts",
        "default": "./dist/color/index.js"
      },
      "module": {
        "types": "./dist/color/index.d.ts",
        "default": "./dist/color/index.js"
      },
      "require": {
        "types": "./dist/cjs/color/index.d.cts",
        "default": "./dist/cjs/color.cjs"
      },
      "types": "./dist/color/index.d.ts",
      "default": "./dist/color/index.js"
    },
    "./aspect": {
      "module-sync": {
        "types": "./dist/aspect/index.d.ts",
        "default": "./dist/aspect/index.js"
      },
      "module": {
        "types": "./dist/aspect/index.d.ts",
        "default": "./dist/aspect/index.js"
      },
      "require": {
        "types": "./dist/cjs/aspect/index.d.cts",
        "default": "./dist/cjs/aspect.cjs"
      },
      "types": "./dist/aspect/index.d.ts",
      "default": "./dist/aspect/index.js"
    },
    "./presets": {
      "module-sync": {
        "types": "./dist/presets/index.d.ts",
        "default": "./dist/presets/index.js"
      },
      "module": {
        "types": "./dist/presets/index.d.ts",
        "default": "./dist/presets/index.js"
      },
      "require": {
        "types": "./dist/cjs/presets/index.d.cts",
        "default": "./dist/cjs/presets.cjs"
      },
      "types": "./dist/presets/index.d.ts",
      "default": "./dist/presets/index.js"
    },
    "./presets/sources.json": "./dist/presets/sources.json",
    "./mp4box": {
      "types": "./dist/plugins/mp4box.d.ts",
      "default": "./dist/plugins/mp4box.js"
    },
    "./mediabunny": {
      "types": "./dist/plugins/mediabunny.d.ts",
      "default": "./dist/plugins/mediabunny.js"
    },
    "./rvfc": {
      "types": "./dist/plugins/rvfc.d.ts",
      "default": "./dist/plugins/rvfc.js"
    },
    "./worker-runtime": {
      "types": "./dist/worker/runtime.d.ts",
      "default": "./dist/worker/runtime.js"
    },
    "./engines/mp4box": {
      "types": "./dist/engines/mp4box.d.ts",
      "default": "./dist/engines/mp4box.js"
    },
    "./engines/mediabunny": {
      "types": "./dist/engines/mediabunny.d.ts",
      "default": "./dist/engines/mediabunny.js"
    },
    "./standalone/own.worker.js": "./dist/standalone/own.worker.js",
    "./standalone/own-isobmff.worker.js": "./dist/standalone/own-isobmff.worker.js",
    "./standalone/own-matroska.worker.js": "./dist/standalone/own-matroska.worker.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "mediabunny": "^1.62.0",
    "mp4box": "^2.4.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "mp4box": {
      "optional": true
    },
    "mediabunny": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "node scripts/build-lib.mjs",
    "build:demo": "tsc -b && vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "check:package": "publint --strict && node scripts/check-dist.mjs",
    "check:types": "npm run check:types:server && npm run check:types:browser",
    "check:types:server": "npx --yes @arethetypeswrong/cli@0.18.5 --pack . --entrypoints . ./header ./url ./color ./aspect ./check ./presets",
    "check:types:browser": "npx --yes @arethetypeswrong/cli@0.18.5 --pack . --ignore-rules cjs-resolves-to-esm --exclude-entrypoints . ./header ./url ./color ./aspect ./check ./presets ./standalone/own.worker.js ./standalone/own-isobmff.worker.js ./standalone/own-matroska.worker.js",
    "prepack": "npm run build:lib && node scripts/check-dist.mjs",
    "check:aliases": "node scripts/src-aliases.mjs --check",
    "check:stable-chunks": "node scripts/check-stable-chunks.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:package": "vitest run -c vitest.package.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:consumers": "playwright test -c playwright.consumers.config.ts",
    "fixtures:generate": "bash scripts/fixtures/generate-fixtures.sh",
    "fixtures:refs": "bash scripts/fixtures/extract-reference.sh",
    "compare": "node scripts/compare-ffprobe.ts",
    "size": "node scripts/size-report.mjs demo/dist",
    "consumers:setup": "node scripts/consumers.mjs setup",
    "consumers:build": "node scripts/consumers.mjs build",
    "size:matrix": "node scripts/size-matrix.mjs --check",
    "size:matrix:write": "node scripts/size-matrix.mjs",
    "bench": "node scripts/bench/run-bench.mjs",
    "preversion": "node scripts/release-prep.mjs --preversion",
    "version": "node scripts/release-prep.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "mediabunny": "1.62.1",
    "mp4box": "2.4.1",
    "oxlint": "1.88.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.14",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
